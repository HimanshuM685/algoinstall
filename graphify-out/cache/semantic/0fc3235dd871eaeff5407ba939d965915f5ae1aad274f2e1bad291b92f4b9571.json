{"nodes": [{"id": "algoinstall_claude_algoinstall", "label": "AlgoInstall", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_algokit", "label": "AlgoKit", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_algorand", "label": "Algorand", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_architecture", "label": "Architecture: What-to-Ensure vs How-to-Install", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The code separates 'what to ensure' (checks/*.sh) from 'how to install it per-platform' (os/*.sh). This separation allows platform-agnostic dependency checks to delegate to platform-specific install hooks, keeping the logic modular."}, {"id": "algoinstall_claude_install_sh", "label": "install.sh Orchestrator", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_utils_sh", "label": "utils.sh Shared Helpers", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_checks_layer", "label": "checks/*.sh Dependency Checks", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_os_layer", "label": "os/*.sh Platform Modules", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algoinstall_claude_platform_contract", "label": "Platform Contract: install_*_os Functions", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "checks/*.sh may only call install_*_os functions that every platform module defines (or guards with declare -F). Adding a new per-platform step requires adding the function to all three os/*.sh files or guarding the call site, to avoid breaking a platform."}, {"id": "algoinstall_claude_local_mode", "label": "Local Execution Mode", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When $SCRIPT_DIR/utils.sh exists next to the script, modules are sourced from disk. This is the default when running bash install.sh in the repo."}, {"id": "algoinstall_claude_bootstrap_mode", "label": "Bootstrap Execution Mode", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When piped via curl | bash, BASH_SOURCE is not a real file, so the script downloads module files from ALGOINSTALL_BASE_URL into a mktemp dir. New module files must be added to the files=(...) array in bootstrap_modules_if_needed or curl | bash users will not get them."}, {"id": "algoinstall_claude_python_fallback_chain", "label": "Python Fallback Chain", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ensure_python tries: (1) distro package via install_python_os, (2) uv installing Python 3.14 via install_python_with_uv_os, (3) building Python 3.14.5 from source via install_python_from_source_os. MIN_PYTHON_VERSION is 3.12 but fallbacks target 3.14 \u2014 this asymmetry is intentional."}, {"id": "algoinstall_claude_algokit_install_verify", "label": "AlgoKit Install and Verify", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "install_algokit prefers pipx install --python $PYTHON_BIN and falls back to uv tool install. verify_algokit locates the algokit binary and symlinks it into a writable PATH dir or /usr/local/bin if not already on the user's original PATH."}, {"id": "algoinstall_claude_dry_run", "label": "Dry-Run Verification Pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--dry-run is the main verification tool. It routes every state-changing command through run_cmd, which prints [dry-run] instead of executing. All install logic must use run_cmd/run_with_sudo for dry-run accuracy."}, {"id": "algoinstall_claude_conventions", "label": "Coding Conventions", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "set -euo pipefail is on; use ${VAR:-} defaults. All user-facing output through utils.sh logging helpers. Linux supports apt/dnf/yum/pacman/zypper/apk via install_packages_os dispatch. Keep scripts POSIX-portable Bash and readable."}], "edges": [{"source": "algoinstall_claude_algoinstall", "target": "algoinstall_claude_algokit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 7", "weight": 1.0}, {"source": "algoinstall_claude_algokit", "target": "algoinstall_claude_algorand", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 7", "weight": 1.0}, {"source": "algoinstall_claude_install_sh", "target": "algoinstall_claude_utils_sh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 29", "weight": 1.0}, {"source": "algoinstall_claude_install_sh", "target": "algoinstall_claude_checks_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 29", "weight": 1.0}, {"source": "algoinstall_claude_install_sh", "target": "algoinstall_claude_os_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 29", "weight": 1.0}, {"source": "algoinstall_claude_checks_layer", "target": "algoinstall_claude_os_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 34", "weight": 1.0}, {"source": "algoinstall_claude_platform_contract", "target": "algoinstall_claude_checks_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 34", "weight": 1.0}, {"source": "algoinstall_claude_platform_contract", "target": "algoinstall_claude_os_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 34", "weight": 1.0}, {"source": "algoinstall_claude_architecture", "target": "algoinstall_claude_checks_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 27", "weight": 1.0}, {"source": "algoinstall_claude_architecture", "target": "algoinstall_claude_os_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 27", "weight": 1.0}, {"source": "algoinstall_claude_local_mode", "target": "algoinstall_claude_install_sh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 40", "weight": 1.0}, {"source": "algoinstall_claude_bootstrap_mode", "target": "algoinstall_claude_install_sh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 41", "weight": 1.0}, {"source": "algoinstall_claude_python_fallback_chain", "target": "algoinstall_claude_checks_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 47", "weight": 1.0}, {"source": "algoinstall_claude_python_fallback_chain", "target": "algoinstall_claude_os_layer", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "line 47", "weight": 0.9}, {"source": "algoinstall_claude_algokit_install_verify", "target": "algoinstall_claude_install_sh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 54", "weight": 1.0}, {"source": "algoinstall_claude_dry_run", "target": "algoinstall_claude_utils_sh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 22", "weight": 1.0}, {"source": "algoinstall_claude_conventions", "target": "algoinstall_claude_utils_sh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 59", "weight": 1.0}, {"source": "algoinstall_claude_dry_run", "target": "algoinstall_readme_security_notes", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "CLAUDE.md", "source_location": null, "we